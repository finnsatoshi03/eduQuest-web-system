    class ProfDash,QuizCreate,QuizCustomize,QuestionManage,ProfGameRoom,LiveAnalytics,ResponseReview,ExcelExport professorPages
    class AuthContext,QuizContext,GameContext,RealtimeContext stateManagement
    class AuthAPI,QuizAPI,RoomAPI,ClassAPI,ScheduledAPI,ExportAPI,AnalyticsAPI apiLayer
    class NLPService,PDFProcessor,QuestionGenerator,ContentAnalyzer aiEngine
    class SupaDB,UsersTable,QuizTable,QuestionsTable,QuizHistoryTable,QuizStudentsTable,QuizStudentAnswersTable,TempRoomTable,TempRoomQuestionsTable,SupaStorage database
    class SupaRealtime,GameBroadcast,TimerSync,LiveUpdates,ParticipantSync realtime
    class GoogleOAuth,EmailService external
    class Users users